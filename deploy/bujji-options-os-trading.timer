[Unit]
# =========================================================================
# BUJJI OPTIONS OS — PAPER TRADING TIMER
#
# Fires the trading session once per intended NSE trading day, AFTER the
# observation systems have run. This is the ONLY scheduling mechanism for
# its service; nothing else triggers it.
# =========================================================================
Description=Daily trigger for Bujji Options OS paper trading session (weekdays only)

[Timer]
# 09:14 IST -- pre-open, holding at the runner's own market-hours gate so
# the session begins WITH the open at 09:15:00 rather than minutes into it.
# See the FIRE TIME block below for why this is safe and where the old
# 09:22:30 burst offset went.
#
# Weekends are excluded structurally by Mon..Fri -- a first, coarse net.
# The SECOND, authoritative check is the runner's own
# MarketCalendar.is_trading_day() gate, which also knows listed NSE
# holidays. On a holiday the timer still fires and the runner exits 0
# immediately: a clean, expected skip, never a fabricated session.
# FIRE TIME: 09:14 IST -- PRE-OPEN, deliberately.
#
# OPERATOR DIRECTIVE 2026-08-19: "Bujji should run through every market
# tick." It previously fired at 09:22:30 and so was ASLEEP for the first 7.5
# minutes of every live session -- the most volatile, least recoverable part
# of the day. The capture units were already fixed this way (09:14 fire +
# bujji/market_reality/open_wait.wait_until_open); this unit now matches, so
# its first decision-grade observation lands with the first tick at 09:15:01.
#
# WHY THIS IS SAFE NOW, AND WAS NOT BEFORE: this unit connects the broker and
# pulls a live chain the instant it starts, and it used to have no
# market-hours gate of any kind -- this timer was its ONLY protection against
# acting on a closed-market book. It now has its own AUTHORITATIVE in-process
# gate, OptionsOSRunner._await_market_open(), which runs BEFORE the broker
# connects: close to the open it waits for 09:15:00; far from the open (a
# stray fire, a manual 05:00 run) it REFUSES with a configuration error.
# The timer is demoted to the coarse first net, exactly like the Mon..Fri
# weekday filter above the runner's authoritative calendar check.
#
# THE 09:22:30 OFFSET WAS NOT DISCARDED, IT MOVED. It existed to keep this
# session's 5-minute bursts off the shadow campaign's :15/:20/:25 beat: the
# pacer in bujji/broker/fyers.py is MODULE level, i.e. per interpreter, with
# no IPC, so two aligned processes pace to ~8.3 calls/s each and the account
# sees ~16.7 against a documented 10/s ceiling. Schedule separation is still
# the only cross-process rate control that exists. That separation is a
# property of the DECISION cadence, not of the start time, so it now lives
# in config as session.continuous.decision_phase_offset_seconds: 150 --
# cycle 1 runs 150s longer, decisions still land on :22:30/:27:30..., and
# the opening minutes are observed instead of slept through.
OnCalendar=Mon..Fri 09:14:00 Asia/Kolkata

# A missed fire (VPS rebooting at 09:20) still runs once the machine is
# back -- but see the runner's own entry-window logic: arriving late in
# the session simply yields fewer management cycles, never a backdated
# entry.
# NO CATCH-UP. This is the one unit that places orders, and it has NO
# market-hours gate of any kind -- it connects the broker and pulls a live
# chain in PRE_MARKET_CHECK the instant it starts, so this timer is its
# only protection against acting on a closed-market book. With
# Persistent=true a reboot at any hour would start a full entry and
# management session immediately, and --date-today would stamp it with the
# BOOT day rather than the day that was missed. A missed trading day is
# strictly better than one entered at 21:00 on stale prices.
Persistent=false

# Overlap prevention, three independent layers:
#   1. systemd defers a second fire while the service still runs.
#   2. bujji.core.process_lock.ProcessLock at data/options_os_trading.lock
#      -- its OWN path, never daily_intelligence.lock or
#      shadow_decision_campaign.lock -- also catches a manual invocation
#      racing a timer-fired one.
#   3. TradingSessionGovernor's own one-strategy-per-day lock inside the
#      session itself.
# 1s, not 1min: a minute-wide accuracy window would let the fire slide
# back into alignment with the campaign and undo the offset above.
AccuracySec=1s

[Install]
WantedBy=timers.target
