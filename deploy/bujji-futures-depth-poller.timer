[Unit]
Description=Daily trigger for the Bujji futures depth poller (weekdays only)

[Timer]
# 09:17, deliberately one minute AFTER bujji-daily-intelligence (09:16).
#
# The script's own gate is `MARKET_OPEN <= now <= MARKET_CLOSE` with
# MARKET_OPEN = 09:15, so 09:15 exactly would race the boundary -- the same
# defect that made this project's 09:00 fire capture nothing every day.
#
# The extra minute past 09:16 staggers process startup. Steady-state polling is
# trivial against the FYERS ceiling (depth is 1 call/60s), but each session
# opens with a burst -- connect, instrument-master resolve, first poll -- and
# the 0.12s pacer in bujji/broker/fyers.py is per-process, not shared across
# processes. Two sessions starting in the same second could brush the
# documented 10/s limit; a minute apart cannot.
#
# Cost of the stagger: ~2 minutes of depth versus the 09:15:13 start of the
# manual 2026-08-14 run. Accepted -- a 429 at open would cost the whole day.
#
# NSE holidays are NOT excluded (no holiday calendar exists in this codebase --
# same disclosed limitation as every other bujji timer). On a holiday the
# script's market-hours gate returns 1 and the unit shows failed: visible, not
# silent, and it writes nothing.
# FIRST-SAMPLE CAPTURE (2026-08-19): fires PRE-open at 09:14; the scripts
# now wait for the open instant themselves (bujji/market_reality/open_wait.py,
# staggered +0/+2/+5s per process), so the 09:15:00-09:15:59 opening minute --
# previously never captured, unrecoverable -- is recorded from the first
# sample. The old 09:16/09:17 fire was the margin against the boundary race
# that made the 09:00-era timer capture zero rows; the wait replaces the
# margin without racing.
OnCalendar=Mon..Fri 09:14 Asia/Kolkata

AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
